{
  "$defs": {
    "ControlKind": {
      "enum": [
        "hello",
        "hello_ack",
        "cancel",
        "backfill",
        "backfill_result",
        "ping",
        "pong",
        "bye"
      ],
      "title": "ControlKind",
      "type": "string"
    }
  },
  "$id": "https://github.com/NoTouchingKids/DBX_leaning/schema/control.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "hello / hello_ack / cancel / ping / pong / bye, exchanged between a job and the app over the WebSocket. Generated from shared/protocol.py.",
  "properties": {
    "kind": {
      "$ref": "#/$defs/ControlKind"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "ts": {
      "title": "Ts",
      "type": "integer"
    }
  },
  "required": [
    "kind",
    "run_id"
  ],
  "title": "ControlFrame",
  "type": "object",
  "x-schema-version": "1.0.0"
}
