# The harness with NO model installed. A negative test, and worth an image of
# its own: the failure a model author hits most often is "DBX_MODEL names
# something that is not installed", and the only useful version of that error
# names what IS.
ARG BASE=dbx-test-base
FROM ${BASE}

WORKDIR /src
COPY . /src
RUN pip install --no-cache-dir -r /src/job/requirements.txt
RUN pip install --no-cache-dir /src
RUN rm -rf /src
WORKDIR /
