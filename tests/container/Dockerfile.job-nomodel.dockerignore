# Kept in agreement with `databricks.yml`'s `sync.exclude` by
# tests/container/test_job_container.py — the job container should see what the
# workspace sync would put there, and nothing more.
#
# BuildKit reads `<dockerfile>.dockerignore` in preference to the context
# root's `.dockerignore`, which is why this lives beside the Dockerfile it
# serves rather than polluting the repo root.
.venv
.git
**/__pycache__
**/.pytest_cache
.ruff_cache
.delta-local
app/client
tests
